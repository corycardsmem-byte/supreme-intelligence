{
  "name": "supreme-intelligence",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "start:api": "npm --workspace apps/api start",
    "start:web": "npm --workspace apps/web start"
  }
}
